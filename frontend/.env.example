# .env.example
NEXT_PUBLIC_API_URL=https://api.hivespace.app
# WebSocket base (Spring Boot host). Local: ws://127.0.0.1:8080 — appends /api/ws/documents/{id}
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8080
NEXT_PUBLIC_APP_URL=https://hivespace.app
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.hivespace.app

# Server-only (no NEXT_PUBLIC prefix — never exposed to browser)
STRIPE_WEBHOOK_SECRET=whsec_...

# Used by `app/api/[...path]/route.ts` when proxying browser /api/* → Spring.
# Must match where Spring Boot listens (gradle bootRun → 8080; backend/docker-compose maps 8088→8080).
BACKEND_URL=http://127.0.0.1:8080